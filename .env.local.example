# Copie para .env.local e preencha os valores reais.
# Veja o README para o passo a passo completo de cada integracao.

# --- Supabase (obrigatorio para rodar o app de verdade) ---
# Criar o projeto em https://supabase.com/dashboard, depois:
# Project Settings > API > Project URL / anon public / service_role
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Mercado Pago (fica para o final — ver checklist no README) ---
# Painel do desenvolvedor: https://www.mercadopago.com.br/developers/panel
MP_ACCESS_TOKEN=
# Segredo do webhook (Notificacoes > Webhooks no painel do Mercado Pago).
# Enquanto nao existir, o endpoint do webhook recusa toda requisicao (401).
MP_WEBHOOK_SECRET=

# URL publica do site em producao — usada como notification_url ao criar
# cobrancas Pix. Em dev local pode ficar com o valor abaixo mesmo.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
